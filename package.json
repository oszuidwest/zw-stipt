{
    "name": "zw-stipt",
    "private": true,
    "description": "Development tooling for the ZuidWest Stipt plugin (wp-env).",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:destroy": "wp-env destroy",
        "env:composer": "wp-env run cli --env-cwd=wp-content/plugins/zw-stipt composer install --no-interaction --prefer-dist",
        "test:php": "wp-env run cli --env-cwd=wp-content/plugins/zw-stipt vendor/bin/phpunit"
    },
    "devDependencies": {
        "@wordpress/env": "^12.0.0"
    }
}
