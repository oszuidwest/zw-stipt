<?xml version="1.0"?>
<ruleset name="ZuidWest Stipt">
    <description>WordPress coding standards for the ZuidWest Stipt plugin.</description>

    <file>src</file>
    <file>zw-stipt.php</file>
    <file>uninstall.php</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <config name="testVersion" value="8.4-"/>

    <!-- Apply defect-oriented WordPress rules without classic formatting conventions. -->
    <rule ref="WordPress-Docs">
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
        <!-- PHPStan @var annotations do not need prose. -->
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamName"/>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.DB">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="text_domain" type="array">
                <element value="zw-stipt"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="prefixes" type="array">
                <element value="zw_stipt"/>
                <element value="ZW_STIPT"/>
                <element value="ZWStipt"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_wp_version" value="7.1"/>
</ruleset>
